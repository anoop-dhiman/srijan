# Srijan Platform — Environment Variables
# Copy this file to .env and fill in all required values before starting.

# ── Required ───────────────────────────────────────────────────────────────────

# Public hostname for the platform (e.g. srijan.example.com)
SRIJAN_DOMAIN=localhost

# Initial admin password (set once; change via UI after first login)
SRIJAN_ADMIN_PASSWORD=change-me-strong-password

# JWT signing secret — generate with: openssl rand -hex 32
SRIJAN_JWT_SECRET=change-me-jwt-secret-min-32-chars

# Encryption key for secrets at rest — generate with: openssl rand -hex 32
SRIJAN_SECRETS_KEY=change-me-secrets-key-32-bytes!!

# ── Optional ───────────────────────────────────────────────────────────────────

# Email for Let's Encrypt ACME certificates (leave empty for localhost/self-signed)
ACME_EMAIL=

# Allowed CORS/WebSocket origin (defaults to SRIJAN_DOMAIN if unset)
SRIJAN_ORIGIN=
